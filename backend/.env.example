# Backend Environment Configuration Example

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# SQLite Database Location (defaults to placement_predictor.db in app directory)
# For persistent disk on Render / Docker, specify full path:
DATABASE_URL=sqlite:///./app/placement_predictor.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: spaCy model name if installed
SPACY_MODEL=en_core_web_sm
